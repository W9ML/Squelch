# This repo is developed on Windows but deploys to Linux (Debian VMs).
# Store text as LF and check out LF everywhere, so shell scripts and
# Python don't get CRLF (`\r`) corruption that breaks them on the target.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.tar.gz binary
*.tgz    binary
*.zip    binary
